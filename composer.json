{
    "name": "psalm/plugin-sabre-event",
    "description": "Psalm plugin for sabre/event",
    "type": "psalm-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Brown",
            "email": "github@muglug.com"
        }
    ],
    "require": {
        "sabre/event": "^5",
        "psalm/psalm-plugin-api": "^0.4",
        "vimeo/psalm": "^7|dev-master"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.3"
    },
    "extra": {
        "psalm": {
            "pluginClass": "Psalm\\SabreEventPlugin\\Plugin"
        }
    },
    "autoload": {
        "psr-4": {
            "Psalm\\SabreEventPlugin\\": ["."]
        }
    },
    "scripts" : {
        "check": [
            "@cs-check",
            "@analyze"
        ],
        "analyze": "psalm",
        "cs-check": "phpcs"
    }
}
