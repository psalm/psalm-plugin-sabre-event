{
    "name": "psalm/plugin-sabre-event",
    "description": "Psalm plugin for sabre/event",
    "license": "MIT",
    "type": "psalm-plugin",
    "authors": [
        {
            "name": "Matt Brown",
            "email": "github@muglug.com"
        }
    ],
    "support": {
        "issues": "https://github.com/psalm/psalm-plugin-sabre-event/issues",
        "source": "https://github.com/psalm/psalm-plugin-sabre-event"
    },
    "require": {
        "psalm/psalm-plugin-api": "^0.4 || ^0.5",
        "vimeo/psalm": "^7 || dev-master"
    },
    "require-dev": {
        "sabre/event": "^5",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "conflict": {
        "sabre/event": "<5.0"
    },
    "autoload": {
        "psr-4": {
            "Psalm\\SabreEventPlugin\\": [
                "."
            ]
        }
    },
    "extra": {
        "psalm": {
            "pluginClass": "Psalm\\SabreEventPlugin\\Plugin"
        }
    },
    "scripts": {
        "analyze": "psalm",
        "check": [
            "@cs-check",
            "@analyze"
        ],
        "cs-check": "phpcs"
    }
}
